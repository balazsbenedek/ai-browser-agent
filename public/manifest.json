{
  "manifest_version": 3,
  "name": "AI Browser Agent — WordPress Editor",
  "version": "0.1.0",
  "description": "Turn any AI chat URL into an agent with full browser control (including tabs already open) and a toolkit specialized for editing WordPress.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "AI Browser Agent"
  },
  "permissions": [
    "tabs",
    "scripting",
    "sidePanel",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/brainAdapter.ts"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": []
}